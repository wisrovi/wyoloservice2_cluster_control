# NeuralForge Cluster Admin - runtime configuration
# Copy to control_host.env and adjust values for your cluster.

# Redis broker (master control host)
CONTROL_HOST=192.168.10.252
REDIS_PORT=23437
REDIS_DB=0
# REDIS_PASSWORD=

# Security (CHANGE IN PRODUCTION)
JWT_SECRET_KEY=change-me-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DEFAULT_ADMIN_USER=wisrovi
DEFAULT_ADMIN_PASSWORD=change-me

# Published host ports
API_PUBLIC_PORT=8001
UI_PUBLIC_PORT=8501
